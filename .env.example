# Copy to .env.local for local work.
# On Vercel / the host: Project → Settings → Environment Variables.
# Do not commit real secrets.

# Pooled connection for the Next.js app (hostname includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Drizzle migrations (no -pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js session signing. Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin of this deployment (no trailing slash). Local: http://localhost:3000
# Production: https://your-workhub-domain
AUTH_URL="http://localhost:3000"

# Allow Auth.js to trust the host header (needed on Vercel previews)
AUTH_TRUST_HOST="true"

# Temporary password shown when an admin/head invites someone
INVITE_STARTER_PASSWORD="replace-with-a-strong-starter-password"

# Used only by `pnpm db:seed` (not required for the running app)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-me"
SEED_STAFF_PASSWORD="replace-me"
SEED_MD_EMAIL="md@example.com"

# Optional later: Google OAuth (not wired yet — leave unset)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
